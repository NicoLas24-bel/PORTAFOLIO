<section id="contacto" class="py-20 px-4 bg-gray-900">
    <div class="max-w-3xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-bold text-center mb-12">
            <span class="bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">Ponte en Contacto</span>
        </h2>
        
        <form class="space-y-6 bg-gray-800 p-8 rounded-lg border border-gray-700">
            <div>
                <label for="nombre" class="block text-sm font-medium mb-2 text-gray-300">Nombre</label>
                <input type="text" id="nombre" name="nombre" required class="w-full px-4 py-2 bg-gray-700 border border-gray-600 rounded text-gray-100 focus:outline-none focus:border-cyan-500 transition" placeholder="Tu nombre">
            </div>
            
            <div>
                <label for="email" class="block text-sm font-medium mb-2 text-gray-300">Email</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-2 bg-gray-700 border border-gray-600 rounded text-gray-100 focus:outline-none focus:border-cyan-500 transition" placeholder="tu@email.com">
            </div>
            
            <div>
                <label for="asunto" class="block text-sm font-medium mb-2 text-gray-300">Asunto</label>
                <input type="text" id="asunto" name="asunto" required class="w-full px-4 py-2 bg-gray-700 border border-gray-600 rounded text-gray-100 focus:outline-none focus:border-cyan-500 transition" placeholder="Asunto del mensaje">
            </div>
            
            <div>
                <label for="mensaje" class="block text-sm font-medium mb-2 text-gray-300">Mensaje</label>
                <textarea id="mensaje" name="mensaje" required rows="5" class="w-full px-4 py-2 bg-gray-700 border border-gray-600 rounded text-gray-100 focus:outline-none focus:border-cyan-500 transition" placeholder="Tu mensaje aquí..."></textarea>
            </div>
            
            <button type="submit" class="w-full px-6 py-3 bg-cyan-500 hover:bg-cyan-600 text-gray-950 font-bold rounded-lg transition">
                Enviar Mensaje
            </button>
        </form>
        
        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
            <div>
                <p class="text-gray-400 mb-2">Email</p>
                <a href="mailto:nicolasllancaqueo0929@gmail.com" class="text-cyan-400 hover:text-cyan-300">nicolasllancaqueo0929@gmail.com</a>
            </div>
            <div>
                <p class="text-gray-400 mb-2">GitHub</p>
                <a href="https://github.com" class="text-cyan-400 hover:text-cyan-300">github.com</a>
            </div>
            <div>
                <p class="text-gray-400 mb-2">LinkedIn</p>
                <a href="https://linkedin.com" class="text-cyan-400 hover:text-cyan-300">linkedin.com</a>
            </div>
        </div>
    </div>
</section>
